# LLM scoring is optional. Leave the key blank to run the deterministic
# rule-based scorer instead. The app never reads these in the browser.
#
# pin the exact model you tested; do not use a moving alias in production
SABILAB_LLM_PROVIDER=openai
SABILAB_LLM_API_KEY=
SABILAB_LLM_MODEL=
# Optional. Any OpenAI-compatible endpoint works with provider=openai.
SABILAB_LLM_BASE_URL=
# Optional. Use a cheaper model for the reading pass and a stronger one for scoring.
SABILAB_LLM_READING_MODEL=
SABILAB_LLM_SCORING_MODEL=

# Optional. Where PGlite keeps its data (default: .data/pglite).
# PGLITE_DIR=.data/pglite

# Production: managed Postgres (Supabase, Neon, Vercel Postgres, etc.).
# Required for deploy. The schema in db/schema.sql is Postgres-dialect and
# runs against both PGlite and managed Postgres.
#
# IMPORTANT for serverless hosts (Netlify, Vercel): use the provider's
# connection POOLER, not the direct host. Supabase's direct host
# (db.<ref>.supabase.co) is IPv6-only and cannot be reached from a serverless
# function, so the app would fail with ENOTFOUND / ENETUNREACH.
#
# Supabase (transaction mode, port 6543) - use this:
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=no-verify
#
# Supabase (session mode, port 5432) - also works:
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=no-verify
#
# sslmode=no-verify is required for the Supabase pooler because its certificate
# does not chain to a public CA for the pooler hostname.
DATABASE_URL=
